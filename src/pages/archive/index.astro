<BaseLayout title="archive — ping's archive">


  <!-- ======================================================
       ARCHIVE HEADING
  ======================================================= -->

  <section class="page-heading archive-heading">

    <div>

      <p class="page-label">
        archive
      </p>

      <h1 class="page-title">
        all findings
      </h1>

    </div>


    <div class="archive-total-count">

      <span class="archive-total-number">
        {String(items.length).padStart(4, "0")}
      </span>

      <span class="archive-total-label">
        {
          items.length === 1
            ? "finding"
            : "findings"
        }
      </span>

    </div>

  </section>



  <!-- ======================================================
       SEARCH / FILTERS
  ======================================================= -->

  <section class="archive-toolbar">


    <div class="archive-search-row">

      <label for="archive-search">
        search
      </label>

      <input
        id="archive-search"
        type="search"
        placeholder="search title, creator, material, theme, place, source..."
        autocomplete="off"
        disabled={items.length === 0}
      />

    </div>



    <div class="archive-toolbar-row">


      <!-- VIEW -->

      <div class="view-control">

        <span class="control-label">
          view
        </span>

        <button
          class="view-button is-active"
          type="button"
          data-view-button="grid"
          aria-pressed="true"
        >
          grid
        </button>

        <button
          class="view-button"
          type="button"
          data-view-button="index"
          aria-pressed="false"
        >
          index
        </button>

      </div>



      <!-- SORT -->

      <div class="sort-control">

        <label
          class="control-label"
          for="archive-sort"
        >
          sort
        </label>

        <select
          id="archive-sort"
          disabled={items.length === 0}
        >

          <option value="newest-added">
            newest added
          </option>

          <option value="oldest-added">
            oldest added
          </option>

          <option value="az">
            a–z
          </option>

          <option value="za">
            z–a
          </option>

        </select>

      </div>


    </div>



    <!-- ====================================================
         FILTERS
    ===================================================== -->

    <details class="archive-filters">

      <summary>
        filter archive
      </summary>


      <div class="archive-filter-groups">


        <div class="filter-group">

          <span class="filter-group-title">
            browse
          </span>


          <div class="filter-grid">


            <!-- OBJECT TYPE -->

            <div class="filter-field">

              <label for="filter-object-type">
                object type
              </label>

              <select
                id="filter-object-type"
                disabled={objectTypes.length === 0}
              >

                <option value="all">
                  all
                </option>

                {
                  objectTypes.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>



            <!-- CREATOR -->

            <div class="filter-field">

              <label for="filter-creator">
                creator
              </label>

              <select
                id="filter-creator"
                disabled={creators.length === 0}
              >

                <option value="all">
                  all
                </option>

                {
                  creators.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>



            <!-- ORIGINAL PERIOD -->

            <div class="filter-field">

              <label for="filter-period">
                original period
              </label>

              <select
                id="filter-period"
                disabled={
                  originalPeriods.length === 0
                }
              >

                <option value="all">
                  all
                </option>

                {
                  originalPeriods.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>



            <!-- THEME -->

            <div class="filter-field">

              <label for="filter-theme">
                theme / concept
              </label>

              <select
                id="filter-theme"
                disabled={themes.length === 0}
              >

                <option value="all">
                  all
                </option>

                {
                  themes.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>



            <!-- COLOR -->

            <div class="filter-field">

              <label for="filter-color">
                color
              </label>

              <select
                id="filter-color"
                disabled={colors.length === 0}
              >

                <option value="all">
                  all
                </option>

                {
                  colors.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>



            <!-- SOURCE / DISCOVERY -->

            <div class="filter-field">

              <label for="filter-source-type">
                source / discovery
              </label>

              <select
                id="filter-source-type"
                disabled={
                  sourceTypes.length === 0
                }
              >

                <option value="all">
                  all
                </option>

                {
                  sourceTypes.map(
                    (value) => (

                      <option value={value}>
                        {value}
                      </option>

                    )
                  )
                }

              </select>

            </div>


          </div>


          <button
            id="archive-clear"
            class="view-button"
            type="button"
          >
            clear search + filters
          </button>


        </div>


      </div>

    </details>


  </section>



  <!-- ======================================================
       FINDINGS
  ======================================================= -->

  <section
    class="archive-results"
    data-archive
    data-view="grid"
  >

    {
      items.map((item) => {


        /* --------------------------------------------------
           BASIC VALUES
        -------------------------------------------------- */

        const findingNumber =
          item.data.archiveNumber ||
          "----";


        const numberValue =
          Number.parseInt(
            item.data.archiveNumber || "0",
            10
          );


        const dateFound =
          item.data.dateFound;


        const foundYear =
          String(
            dateFound.getUTCFullYear()
          );


        const foundMonth =
          dateFound.toLocaleDateString(
            "en-US",
            {
              month: "long",
              timeZone: "UTC",
            }
          );


        const foundDay =
          String(
            dateFound.getUTCDate()
          );


        /* --------------------------------------------------
           NEW + LEGACY METADATA
        -------------------------------------------------- */

        const itemCreators =
          creatorNames(item);


        const creatorValues =
          creatorSearchValues(item);


        const itemLocations =
          locationsFor(item);


        const primaryType =
          primaryTypeFor(item);


        const itemObjectTypes =
          [
            primaryType,
            ...(item.data
              .secondaryObjectTypes || []),
          ].filter(Boolean);


        const originalYear =
          originalYearFor(item);


        const originalDecade =
          decadeFor(originalYear);


        const originalCentury =
          centuryFor(originalYear);


        const itemSourceTypes =
          [
            item.data.primarySource?.type,
            item.data.discovery?.type,
          ].filter(Boolean);


        /* --------------------------------------------------
           UNIVERSAL SEARCH INDEX
        -------------------------------------------------- */

        const searchValues = [

          /* SYSTEM */

          item.data.archiveNumber,


          /* TITLE */

          item.data.title,


          /* CREATOR */

          ...creatorValues,


          /* WRITING */

          item.data.archiveDescription,
          item.data.reason,
          item.body,


          /* DATE FOUND */

          foundYear,
          foundMonth,
          foundDay,


          /* ORIGINAL DATE */

          ...originalDateSearchValues(item),


          /* CLASSIFICATION */

          primaryType,

          ...(item.data
            .secondaryObjectTypes || []),

          ...(item.data.mediums || []),

          ...(item.data.themes || []),


          /* COLOR */

          ...(item.data.colors || []),

          item.data.colorNotes,


          /* SERIES */

          item.data.seriesProject,
          item.data.bodyOfWork,


          /* LOCATION */

          ...itemLocations,


          /* SOURCE / DISCOVERY */

          ...sourceSearchValues(item),


          /* MEDIA */

          item.data.coverType,

          ...additionalMediaSearchValues(
            item
          ),


          /* TEMPORARY LEGACY SEARCH */

          ...(item.data.tags || []),

        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();


        const titleSearch =
          item.data.title.toLowerCase();


        const creatorSearch =
          creatorValues
            .join(" ")
            .toLowerCase();


        const classificationSearch =
          [

            ...itemObjectTypes,

            ...(item.data.mediums || []),

            ...(item.data.themes || []),

            ...(item.data.colors || []),

            ...itemLocations,

          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();


        /* --------------------------------------------------
           CARD META
        -------------------------------------------------- */

        const cardLocation =
          itemLocations[0] || "";


        return (

          <a
            href={`/archive/${item.id}/`}
            class="archive-entry"

            data-number={
              String(numberValue)
            }

            data-title={
              titleSearch
            }

            data-title-search={
              titleSearch
            }

            data-creator-search={
              creatorSearch
            }

            data-classification-search={
              classificationSearch
            }

            data-search={
              searchValues
            }

            data-object-types={
              itemObjectTypes
                .map(
                  (value) =>
                    String(value)
                      .toLowerCase()
                )
                .join("|")
            }

            data-creators={
              itemCreators
                .map(
                  (value) =>
                    String(value)
                      .toLowerCase()
                )
                .join("|")
            }

            data-periods={
              [
                originalYear
                  ? String(originalYear)
                  : "",

                originalDecade,

                originalCentury,
              ]
                .filter(Boolean)
                .map(
                  (value) =>
                    String(value)
                      .toLowerCase()
                )
                .join("|")
            }

            data-themes={
              (item.data.themes || [])
                .map(
                  (value) =>
                    value.toLowerCase()
                )
                .join("|")
            }

            data-colors={
              (item.data.colors || [])
                .map(
                  (value) =>
                    value.toLowerCase()
                )
                .join("|")
            }

            data-source-types={
              itemSourceTypes
                .map(
                  (value) =>
                    String(value)
                      .toLowerCase()
                )
                .join("|")
            }

            data-date-found={
              item.data.dateFound
                .toISOString()
            }
          >


            <!-- COVER -->

            <div class="archive-entry-image">

              <ArchiveMedia
                src={item.data.image}
                coverType={
                  item.data.coverType
                }
                poster={
                  item.data.videoPoster
                }
                alt={
                  item.data.alt ||
                  item.data.title
                }
                title={
                  item.data.title
                }
                context="card"
                loading="lazy"
              />

            </div>



            <!-- INFORMATION -->

            <div class="archive-entry-information">


              <span class="archive-accession">
                NO. {findingNumber}
              </span>


              <h2>
                {item.data.title}
              </h2>


              <p class="archive-entry-meta">

                {
                  [
                    primaryType,
                    cardLocation,
                  ]
                    .filter(Boolean)
                    .join(" / ")
                }

              </p>


              <time
                datetime={
                  item.data.dateFound
                    .toISOString()
                }
              >

                {
                  item.data.dateFound
                    .toLocaleDateString(
                      "en-US",
                      {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC",
                      }
                    )
                }

              </time>


            </div>


          </a>

        );

      })
    }

  </section>



  <!-- ======================================================
       NO RESULTS
  ======================================================= -->

  <div
    class="archive-no-results"
    data-no-results
    hidden
  >
    no findings match your search or filters.
  </div>



  <!-- ======================================================
       SEARCH / FILTER / SORT / VIEW
  ======================================================= -->

  <script>


    /* ------------------------------------------------------
       ELEMENTS
    ------------------------------------------------------ */

    const archive =
      document.querySelector<HTMLElement>(
        "[data-archive]"
      );


    const entries =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".archive-entry"
        )
      );


    const search =
      document.querySelector<HTMLInputElement>(
        "#archive-search"
      );


    const objectType =
      document.querySelector<HTMLSelectElement>(
        "#filter-object-type"
      );


    const creator =
      document.querySelector<HTMLSelectElement>(
        "#filter-creator"
      );


    const period =
      document.querySelector<HTMLSelectElement>(
        "#filter-period"
      );


    const theme =
      document.querySelector<HTMLSelectElement>(
        "#filter-theme"
      );


    const color =
      document.querySelector<HTMLSelectElement>(
        "#filter-color"
      );


    const sourceType =
      document.querySelector<HTMLSelectElement>(
        "#filter-source-type"
      );


    const sort =
      document.querySelector<HTMLSelectElement>(
        "#archive-sort"
      );


    const clear =
      document.querySelector<HTMLButtonElement>(
        "#archive-clear"
      );


    const noResults =
      document.querySelector<HTMLElement>(
        "[data-no-results]"
      );



    /* ------------------------------------------------------
       SEARCH NORMALIZATION
    ------------------------------------------------------ */

    function normalizeText(
      value: string
    ) {

      return value
        .toLowerCase()

        /* Useful archive abbreviations */

        .replace(/\bf\/w\b/g, "fw")
        .replace(/\bs\/s\b/g, "ss")
        .replace(/\bb&w\b/g, "bw")

        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          ""
        )

        .replace(
          /[^a-z0-9]+/g,
          " "
        )

        .replace(
          /\s+/g,
          " "
        )

        .trim();

    }



    /* ------------------------------------------------------
       SYNONYM GROUPS
    ------------------------------------------------------ */

    const synonymGroups = [

      [
        "photo",
        "photograph",
        "photography",
        "photographic",
      ],

      [
        "gif",
        "loop",
        "animation",
        "animated",
      ],

      [
        "nyc",
        "new york city",
      ],

      [
        "bw",
        "black and white",
        "black white",
      ],

      [
        "ceramic",
        "ceramics",
      ],

      [
        "fw",
        "fall winter",
      ],

      [
        "ss",
        "spring summer",
      ],

      [
        "movie",
        "film",
        "cinema",
      ],

      [
        "audio",
        "sound",
        "recording",
      ],

      [
        "twitter",
        "x twitter",
        "x com",
      ],

    ].map(
      (group) =>
        group.map(normalizeText)
    );



    function variantsForToken(
      token: string
    ) {

      const normalized =
        normalizeText(token);


      const group =
        synonymGroups.find(
          (values) =>
            values.includes(normalized)
        );


      return group || [normalized];

    }



    function queryTokens() {

      if (!search?.value) {
        return [];
      }


      return normalizeText(
        search.value
      )
        .split(" ")
        .filter(Boolean);

    }



    function textMatchesToken(
      source: string,
      token: string
    ) {

      const normalizedSource =
        normalizeText(source);


      return variantsForToken(token)
        .some(
          (variant) =>
            normalizedSource.includes(
              variant
            )
        );

    }



    /* ------------------------------------------------------
       FILTER MATCHING
    ------------------------------------------------------ */

    function listMatch(
      source: string | undefined,
      selected: string | undefined
    ) {

      if (
        !selected ||
        selected === "all"
      ) {
        return true;
      }


      const wanted =
        normalizeText(selected);


      return (
        source || ""
      )
        .split("|")
        .map(normalizeText)
        .includes(wanted);

    }



    function entryMatchesSearch(
      entry: HTMLElement,
      tokens: string[]
    ) {

      if (
        tokens.length === 0
      ) {
        return true;
      }


      const fullSearch =
        entry.dataset.search || "";


      /*
        Every query word must appear somewhere.

        Example:
        "blue rothko paper"

        can match across three different metadata
        fields.
      */

      return tokens.every(
        (token) =>
          textMatchesToken(
            fullSearch,
            token
          )
      );

    }



    /* ------------------------------------------------------
       SEARCH RELEVANCE

       Title > Creator > Classification > everything else.
    ------------------------------------------------------ */

    function relevanceScore(
      entry: HTMLElement,
      tokens: string[]
    ) {

      if (
        tokens.length === 0
      ) {
        return 0;
      }


      const titleText =
        entry.dataset.titleSearch || "";


      const creatorText =
        entry.dataset.creatorSearch || "";


      const classificationText =
        entry.dataset
          .classificationSearch || "";


      const fullText =
        entry.dataset.search || "";


      let score = 0;


      tokens.forEach((token) => {

        if (
          textMatchesToken(
            titleText,
            token
          )
        ) {
          score += 10;
        }


        if (
          textMatchesToken(
            creatorText,
            token
          )
        ) {
          score += 7;
        }


        if (
          textMatchesToken(
            classificationText,
            token
          )
        ) {
          score += 4;
        }


        if (
          textMatchesToken(
            fullText,
            token
          )
        ) {
          score += 1;
        }

      });


      return score;

    }



    /* ------------------------------------------------------
       STANDARD SORT
    ------------------------------------------------------ */

    function standardCompare(
      a: HTMLElement,
      b: HTMLElement
    ) {

      const selected =
        sort?.value ||
        "newest-added";


      if (
        selected ===
        "oldest-added"
      ) {

        return (
          Number(
            a.dataset.number || "0"
          )
          -
          Number(
            b.dataset.number || "0"
          )
        );

      }


      if (
        selected === "az"
      ) {

        return (
          a.dataset.title || ""
        ).localeCompare(
          b.dataset.title || ""
        );

      }


      if (
        selected === "za"
      ) {

        return (
          b.dataset.title || ""
        ).localeCompare(
          a.dataset.title || ""
        );

      }


      /*
        DEFAULT:
        newest added = highest permanent
        Finding No.
      */

      return (
        Number(
          b.dataset.number || "0"
        )
        -
        Number(
          a.dataset.number || "0"
        )
      );

    }



    /* ------------------------------------------------------
       REORDER
    ------------------------------------------------------ */

    function reorderEntries(
      tokens: string[]
    ) {

      if (!archive) {
        return;
      }


      const sorted =
        [...entries];


      sorted.sort((a, b) => {


        /*
          When searching, relevance gets first
          priority.

          The selected sort breaks ties.
        */

        if (
          tokens.length > 0
        ) {

          const difference =
            relevanceScore(
              b,
              tokens
            )
            -
            relevanceScore(
              a,
              tokens
            );


          if (difference !== 0) {
            return difference;
          }

        }


        return standardCompare(
          a,
          b
        );

      });


      sorted.forEach(
        (entry) =>
          archive.appendChild(entry)
      );

    }



    /* ------------------------------------------------------
       APPLY SEARCH + FILTERS
    ------------------------------------------------------ */

    function applyArchiveControls() {

      const tokens =
        queryTokens();


      let visible = 0;


      entries.forEach((entry) => {


        const show =

          entryMatchesSearch(
            entry,
            tokens
          )

          &&

          listMatch(
            entry.dataset.objectTypes,
            objectType?.value
          )

          &&

          listMatch(
            entry.dataset.creators,
            creator?.value
          )

          &&

          listMatch(
            entry.dataset.periods,
            period?.value
          )

          &&

          listMatch(
            entry.dataset.themes,
            theme?.value
          )

          &&

          listMatch(
            entry.dataset.colors,
            color?.value
          )

          &&

          listMatch(
            entry.dataset.sourceTypes,
            sourceType?.value
          );


        entry.hidden =
          !show;


        if (show) {
          visible++;
        }

      });


      reorderEntries(tokens);


      if (noResults) {

        noResults.hidden =
          visible !== 0 ||
          entries.length === 0;

      }

    }



    /* ------------------------------------------------------
       EVENTS
    ------------------------------------------------------ */

    search?.addEventListener(
      "input",
      applyArchiveControls
    );


    [
      objectType,
      creator,
      period,
      theme,
      color,
      sourceType,
      sort,
    ].forEach((control) => {

      control?.addEventListener(
        "change",
        applyArchiveControls
      );

    });



    /* ------------------------------------------------------
       CLEAR
    ------------------------------------------------------ */

    clear?.addEventListener(
      "click",
      () => {


        if (search) {
          search.value = "";
        }


        [
          objectType,
          creator,
          period,
          theme,
          color,
          sourceType,
        ].forEach((control) => {

          if (control) {
            control.value = "all";
          }

        });


        if (sort) {
          sort.value = "newest-added";
        }


        applyArchiveControls();

      }
    );



    /* ------------------------------------------------------
       GRID / INDEX VIEW
    ------------------------------------------------------ */

    const viewButtons =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-view-button]"
      );


    viewButtons.forEach((button) => {


      button.addEventListener(
        "click",
        () => {


          if (!archive) {
            return;
          }


          archive.dataset.view =
            button.dataset.viewButton ||
            "grid";


          viewButtons.forEach(
            (other) => {


              const active =
                other === button;


              other.classList.toggle(
                "is-active",
                active
              );


              other.setAttribute(
                "aria-pressed",
                String(active)
              );


            }
          );


        }
      );


    });



    /* ------------------------------------------------------
       INITIAL STATE
    ------------------------------------------------------ */

    applyArchiveControls();


  </script>


</BaseLayout>