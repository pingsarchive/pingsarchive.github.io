---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveMedia from "../../components/ArchiveMedia.astro";
import { getCollection } from "astro:content";


const items = (
  await getCollection(
    "archive",
    ({ data }) => !data.private
  )
).sort(
  (a, b) =>
    b.data.dateFound.getTime() -
    a.data.dateFound.getTime()
);


/* =========================================
   AUTOMATIC FILTER OPTIONS
========================================= */

const years = Array.from(
  new Set(
    items.map((item) =>
      String(item.data.dateFound.getFullYear())
    )
  )
).sort((a, b) => Number(b) - Number(a));


const months = Array.from(
  new Set(
    items.map((item) =>
      item.data.dateFound.toLocaleDateString(
        "en-US",
        { month: "long" }
      )
    )
  )
);


const weekdays = Array.from(
  new Set(
    items.map((item) =>
      item.data.dateFound.toLocaleDateString(
        "en-US",
        { weekday: "long" }
      )
    )
  )
);


const countries = Array.from(
  new Set(
    items
      .map((item) => item.data.country)
      .filter(Boolean)
  )
).sort();


const cities = Array.from(
  new Set(
    items
      .map((item) => item.data.city)
      .filter(Boolean)
  )
).sort();


const venues = Array.from(
  new Set(
    items
      .map((item) => item.data.venue)
      .filter(Boolean)
  )
).sort();


const collections = Array.from(
  new Set(
    items.flatMap(
      (item) => item.data.collections
    )
  )
).sort();


const kinds = Array.from(
  new Set(
    items
      .map((item) => item.data.kind)
      .filter(Boolean)
  )
).sort();
---

<BaseLayout title="archive — ping's archive">


  <!-- =========================================
       ARCHIVE HEADING
  ========================================== -->

  <section class="page-heading archive-heading">

    <div>

      <p class="page-label">
        archive
      </p>

      <h1 class="page-title">
        all findings
      </h1>

    </div>


    <div class="archive-total-count">

      <span class="archive-total-number">
        {String(items.length).padStart(4, "0")}
      </span>

      <span class="archive-total-label">
        {items.length === 1 ? "finding" : "findings"}
      </span>

    </div>

  </section>



  <!-- =========================================
       SEARCH / FILTERS
  ========================================== -->

  <section class="archive-toolbar">


    <div class="archive-search-row">

      <label for="archive-search">
        search
      </label>

      <input
        id="archive-search"
        type="search"
        placeholder="search the archive..."
        disabled={items.length === 0}
      />

    </div>



    <div class="archive-toolbar-row">


      <div class="view-control">

        <span class="control-label">
          view
        </span>

        <button
          class="view-button is-active"
          type="button"
          data-view-button="grid"
          aria-pressed="true"
        >
          grid
        </button>

        <button
          class="view-button"
          type="button"
          data-view-button="index"
          aria-pressed="false"
        >
          index
        </button>

      </div>



      <div class="sort-control">

        <label
          class="control-label"
          for="archive-sort"
        >
          sort
        </label>

        <select
          id="archive-sort"
          disabled={items.length === 0}
        >

          <option value="newest">
            newest
          </option>

          <option value="oldest">
            oldest
          </option>

          <option value="az">
            a–z
          </option>

          <option value="za">
            z–a
          </option>

        </select>

      </div>


    </div>



    <!-- COLLAPSED BY DEFAULT -->

    <details class="archive-filters">

      <summary>
        filter archive
      </summary>


      <div class="archive-filter-groups">


        <!-- DATE -->

        <div class="filter-group">

          <span class="filter-group-title">
            date
          </span>


          <div class="filter-grid">


            <div class="filter-field">

              <label for="filter-year">
                year
              </label>

              <select id="filter-year">

                <option value="all">
                  all
                </option>

                {
                  years.map((year) => (
                    <option value={year}>
                      {year}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-month">
                month
              </label>

              <select id="filter-month">

                <option value="all">
                  all
                </option>

                {
                  months.map((month) => (
                    <option value={month}>
                      {month}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-weekday">
                day
              </label>

              <select id="filter-weekday">

                <option value="all">
                  all
                </option>

                {
                  weekdays.map((weekday) => (
                    <option value={weekday}>
                      {weekday}
                    </option>
                  ))
                }

              </select>

            </div>


          </div>

        </div>



        <!-- PLACE -->

        <div class="filter-group">

          <span class="filter-group-title">
            place
          </span>


          <div class="filter-grid">


            <div class="filter-field">

              <label for="filter-country">
                country
              </label>

              <select id="filter-country">

                <option value="all">
                  all
                </option>

                {
                  countries.map((country) => (
                    <option value={country}>
                      {country}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-city">
                city
              </label>

              <select id="filter-city">

                <option value="all">
                  all
                </option>

                {
                  cities.map((city) => (
                    <option value={city}>
                      {city}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-venue">
                venue
              </label>

              <select id="filter-venue">

                <option value="all">
                  all
                </option>

                {
                  venues.map((venue) => (
                    <option value={venue}>
                      {venue}
                    </option>
                  ))
                }

              </select>

            </div>


          </div>

        </div>



        <!-- ARCHIVE -->

        <div class="filter-group">

          <span class="filter-group-title">
            archive
          </span>


          <div class="filter-grid">


            <div class="filter-field">

              <label for="filter-collection">
                collection
              </label>

              <select id="filter-collection">

                <option value="all">
                  all
                </option>

                {
                  collections.map((collection) => (
                    <option value={collection}>
                      {collection}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-kind">
                what is it?
              </label>

              <select id="filter-kind">

                <option value="all">
                  all
                </option>

                {
                  kinds.map((kind) => (
                    <option value={kind}>
                      {kind}
                    </option>
                  ))
                }

              </select>

            </div>



            <div class="filter-field">

              <label for="filter-favorite">
                favorites
              </label>

              <select id="filter-favorite">

                <option value="all">
                  all
                </option>

                <option value="favorite">
                  favorites only
                </option>

              </select>

            </div>


          </div>

        </div>


      </div>

    </details>


  </section>



  <!-- =========================================
       FINDINGS
  ========================================== -->

  <section
    class="archive-results"
    data-archive
    data-view="grid"
  >

    {
      items.map((item) => {

        const date =
          item.data.dateFound;

        const year =
          String(date.getFullYear());

        const month =
          date.toLocaleDateString(
            "en-US",
            { month: "long" }
          );

        const weekday =
          date.toLocaleDateString(
            "en-US",
            { weekday: "long" }
          );


        const findingNumber =
          item.data.archiveNumber ||
          "----";


        return (

          <a
            href={`/archive/${item.id}/`}
            class="archive-entry"

            data-title={
              item.data.title.toLowerCase()
            }

            data-search={
              [
                item.data.archiveNumber,
                item.data.title,
                item.data.creator,
                item.data.archiveDescription,
                item.data.location,
                item.data.country,
                item.data.region,
                item.data.city,
                item.data.neighborhood,
                item.data.venue,
                item.data.kind,
                item.data.reason,
                item.data.sourceName,

                ...item.data.tags,
                ...item.data.colors,
                ...item.data.collections

              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase()
            }

            data-year={year}

            data-month={
              month.toLowerCase()
            }

            data-weekday={
              weekday.toLowerCase()
            }

            data-country={
              (item.data.country || "")
                .toLowerCase()
            }

            data-city={
              (item.data.city || "")
                .toLowerCase()
            }

            data-venue={
              (item.data.venue || "")
                .toLowerCase()
            }

            data-kind={
              (item.data.kind || "")
                .toLowerCase()
            }

            data-collections={
              item.data.collections
                .map((value) =>
                  value.toLowerCase()
                )
                .join("|")
            }

            data-favorite={
              item.data.favorite
                ? "true"
                : "false"
            }

            data-date={
              item.data.dateFound.toISOString()
            }
          >


            <div class="archive-entry-image">
  <ArchiveMedia
    src={item.data.image}
    coverType={item.data.coverType}
    poster={item.data.videoPoster}
    alt={
      item.data.alt ||
      item.data.title
    }
    title={item.data.title}
    context="card"
    loading="lazy"
  />
</div>



            <div class="archive-entry-information">


              <span class="archive-accession">
                NO. {findingNumber}
              </span>


              <h2>
                {item.data.title}
              </h2>


              <p class="archive-entry-meta">

                {
                  [
                    item.data.kind,

                    item.data.city ||
                    item.data.country ||
                    item.data.location

                  ]
                    .filter(Boolean)
                    .join(" / ")
                }

              </p>


              <time
                datetime={
                  item.data.dateFound.toISOString()
                }
              >

                {
                  item.data.dateFound.toLocaleDateString(
                    "en-US",
                    {
                      month: "short",
                      day: "numeric",
                      year: "numeric"
                    }
                  )
                }

              </time>


            </div>


          </a>

        );

      })
    }

  </section>



  <div
    class="archive-no-results"
    data-no-results
    hidden
  >
    no findings match these filters.
  </div>



  <!-- =========================================
       FILTER / SORT / VIEW
  ========================================== -->

  <script>


    const archive =
      document.querySelector<HTMLElement>(
        "[data-archive]"
      );


    const entries =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".archive-entry"
        )
      );


    const search =
      document.querySelector<HTMLInputElement>(
        "#archive-search"
      );


    const year =
      document.querySelector<HTMLSelectElement>(
        "#filter-year"
      );


    const month =
      document.querySelector<HTMLSelectElement>(
        "#filter-month"
      );


    const weekday =
      document.querySelector<HTMLSelectElement>(
        "#filter-weekday"
      );


    const country =
      document.querySelector<HTMLSelectElement>(
        "#filter-country"
      );


    const city =
      document.querySelector<HTMLSelectElement>(
        "#filter-city"
      );


    const venue =
      document.querySelector<HTMLSelectElement>(
        "#filter-venue"
      );


    const collection =
      document.querySelector<HTMLSelectElement>(
        "#filter-collection"
      );


    const kind =
      document.querySelector<HTMLSelectElement>(
        "#filter-kind"
      );


    const favorite =
      document.querySelector<HTMLSelectElement>(
        "#filter-favorite"
      );


    const sort =
      document.querySelector<HTMLSelectElement>(
        "#archive-sort"
      );


    const noResults =
      document.querySelector<HTMLElement>(
        "[data-no-results]"
      );



    function simpleMatch(
      source: string | undefined,
      selected: string
    ) {

      if (selected === "all") {
        return true;
      }


      return (
        (source || "") ===
        selected.toLowerCase()
      );

    }



    function listMatch(
      source: string | undefined,
      selected: string
    ) {

      if (selected === "all") {
        return true;
      }


      return (source || "")
        .split("|")
        .includes(
          selected.toLowerCase()
        );

    }



    function applyFilters() {


      const query =
        search?.value
          .trim()
          .toLowerCase() || "";


      let visible = 0;



      entries.forEach((entry) => {


        const show =

          (
            !query ||
            (entry.dataset.search || "")
              .includes(query)
          )

          &&

          (
            !year ||
            simpleMatch(
              entry.dataset.year,
              year.value
            )
          )

          &&

          (
            !month ||
            simpleMatch(
              entry.dataset.month,
              month.value
            )
          )

          &&

          (
            !weekday ||
            simpleMatch(
              entry.dataset.weekday,
              weekday.value
            )
          )

          &&

          (
            !country ||
            simpleMatch(
              entry.dataset.country,
              country.value
            )
          )

          &&

          (
            !city ||
            simpleMatch(
              entry.dataset.city,
              city.value
            )
          )

          &&

          (
            !venue ||
            simpleMatch(
              entry.dataset.venue,
              venue.value
            )
          )

          &&

          (
            !collection ||
            listMatch(
              entry.dataset.collections,
              collection.value
            )
          )

          &&

          (
            !kind ||
            simpleMatch(
              entry.dataset.kind,
              kind.value
            )
          )

          &&

          (
            !favorite ||
            favorite.value === "all" ||
            entry.dataset.favorite === "true"
          );


        entry.hidden =
          !show;


        if (show) {
          visible++;
        }

      });



      if (noResults) {

        noResults.hidden =
          visible !== 0 ||
          entries.length === 0;

      }

    }



    [
      search,
      year,
      month,
      weekday,
      country,
      city,
      venue,
      collection,
      kind,
      favorite
    ].forEach((control) => {


      if (!control) {
        return;
      }


      control.addEventListener(

        control instanceof HTMLInputElement
          ? "input"
          : "change",

        applyFilters

      );

    });



    sort?.addEventListener(
      "change",
      () => {


        if (!archive) {
          return;
        }


        const sorted =
          [...entries];


        sorted.sort((a, b) => {


          if (sort.value === "oldest") {

            return (
              new Date(
                a.dataset.date || ""
              ).getTime()
              -
              new Date(
                b.dataset.date || ""
              ).getTime()
            );

          }


          if (sort.value === "az") {

            return (
              a.dataset.title || ""
            ).localeCompare(
              b.dataset.title || ""
            );

          }


          if (sort.value === "za") {

            return (
              b.dataset.title || ""
            ).localeCompare(
              a.dataset.title || ""
            );

          }


          return (
            new Date(
              b.dataset.date || ""
            ).getTime()
            -
            new Date(
              a.dataset.date || ""
            ).getTime()
          );

        });



        sorted.forEach((entry) => {

          archive.appendChild(entry);

        });


      }
    );



    const viewButtons =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-view-button]"
      );


    viewButtons.forEach((button) => {


      button.addEventListener(
        "click",
        () => {


          if (!archive) {
            return;
          }


          archive.dataset.view =
            button.dataset.viewButton ||
            "grid";


          viewButtons.forEach(
            (other) => {


              const active =
                other === button;


              other.classList.toggle(
                "is-active",
                active
              );


              other.setAttribute(
                "aria-pressed",
                String(active)
              );


            }
          );


        }
      );


    });


  </script>


</BaseLayout>