import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveMedia from "../../components/ArchiveMedia.astro";
import { getCollection } from "astro:content";


/* ==========================================================
   ARCHIVE
========================================================== */

const items = (
  await getCollection(
    "archive",
    ({ data }) => !data.private
  )
).sort((a, b) => {

  const aNumber =
    Number.parseInt(
      a.data.archiveNumber || "0",
      10
    );

  const bNumber =
    Number.parseInt(
      b.data.archiveNumber || "0",
      10
    );

  return bNumber - aNumber;

});



/* ==========================================================
   HELPERS
========================================================== */

function uniqueSorted(
  values: Array<string | undefined>
) {

  return Array.from(
    new Set(
      values
        .filter(
          (value): value is string =>
            Boolean(value?.trim())
        )
        .map(
          (value) => value.trim()
        )
    )
  ).sort(
    (a, b) =>
      a.localeCompare(b)
  );

}


function creatorNames(item: any) {

  if (
    item.data.creators?.length
  ) {

    return item.data.creators
      .map(
        (creator: any) =>
          creator.name
      )
      .filter(Boolean);

  }

  return item.data.creator
    ? [item.data.creator]
    : [];

}


function creatorSearchValues(item: any) {

  const modern =
    item.data.creators?.flatMap(
      (creator: any) => [
        creator.name,
        creator.role,
      ]
    ) || [];

  return [
    ...modern,
    item.data.creator,
  ].filter(Boolean);

}


function locationsFor(item: any) {

  if (
    item.data.locations?.length
  ) {
    return item.data.locations;
  }

  return [
    item.data.location,
    item.data.venue,
    item.data.neighborhood,
    item.data.city,
    item.data.region,
    item.data.country,
  ].filter(Boolean);

}


function primaryTypeFor(item: any) {

  return (
    item.data.primaryObjectType ||
    item.data.kind ||
    ""
  );

}


function originalYearFor(item: any) {

  const structuredYear =
    item.data.originalDateDetails
      ?.year;

  if (
    typeof structuredYear ===
    "number"
  ) {
    return structuredYear;
  }


  const legacy =
    item.data.originalDate || "";


  const match =
    String(legacy).match(
      /\b(1[0-9]{3}|20[0-9]{2}|21[0-9]{2})\b/
    );


  return match
    ? Number(match[1])
    : undefined;

}


function decadeFor(
  year?: number
) {

  if (!year) {
    return "";
  }

  return (
    `${Math.floor(year / 10) * 10}s`
  );

}


function ordinal(
  value: number
) {

  const remainder100 =
    value % 100;

  if (
    remainder100 >= 11 &&
    remainder100 <= 13
  ) {
    return `${value}th`;
  }

  switch (value % 10) {

    case 1:
      return `${value}st`;

    case 2:
      return `${value}nd`;

    case 3:
      return `${value}rd`;

    default:
      return `${value}th`;

  }

}


function centuryFor(
  year?: number
) {

  if (!year) {
    return "";
  }

  return (
    `${ordinal(
      Math.ceil(year / 100)
    )} century`
  );

}


function originalDateSearchValues(
  item: any
) {

  const details =
    item.data.originalDateDetails;


  const year =
    originalYearFor(item);


  return [

    item.data.originalDate,

    details?.year,
    details?.month,
    details?.day,
    details?.season,
    details?.timeOfDay,
    details?.qualifier,
    details?.endYear,
    details?.eraLabel,
    details?.dateNote,

    year,
    decadeFor(year),
    centuryFor(year),

  ].filter(Boolean);

}


function sourceSearchValues(
  item: any
) {

  return [

    item.data.primarySource?.type,
    item.data.primarySource?.name,
    item.data.primarySource?.url,

    item.data.discovery?.type,
    item.data.discovery?.name,
    item.data.discovery?.url,

    item.data.sourceName,
    item.data.sourceUrl,

  ].filter(Boolean);

}


function additionalMediaSearchValues(
  item: any
) {

  const modern =
    item.data.additionalMedia
      ?.flatMap(
        (media: any) => [
          media.mediaType,
          media.caption,
          media.credit,
          media.sourceUrl,
        ]
      ) || [];


  const legacyGallery =
    item.data.gallery
      ?.flatMap(
        (media: any) => [
          media.caption,
          media.credit,
          media.sourceUrl,
        ]
      ) || [];


  const legacyAttachments =
    item.data.attachments
      ?.flatMap(
        (attachment: any) => [
          attachment.title,
        ]
      ) || [];


  return [
    ...modern,
    ...legacyGallery,
    ...legacyAttachments,
  ].filter(Boolean);

}



/* ==========================================================
   AUTOMATIC FILTER OPTIONS
========================================================== */

const objectTypes =
  uniqueSorted(
    items.flatMap(
      (item) => {

        const primary =
          primaryTypeFor(item);

        return [
          primary,
          ...(item.data
            .secondaryObjectTypes || []),
        ];

      }
    )
  );


const creators =
  uniqueSorted(
    items.flatMap(
      (item) =>
        creatorNames(item)
    )
  );


const originalPeriods =
  Array.from(
    new Set(
      items
        .map(
          (item) =>
            decadeFor(
              originalYearFor(item)
            )
        )
        .filter(Boolean)
    )
  ).sort(
    (a, b) =>
      Number.parseInt(b, 10) -
      Number.parseInt(a, 10)
  );


const themes =
  uniqueSorted(
    items.flatMap(
      (item) =>
        item.data.themes || []
    )
  );


const colors =
  uniqueSorted(
    items.flatMap(
      (item) =>
        item.data.colors || []
    )
  );


const sourceTypes =
  uniqueSorted(
    items.flatMap(
      (item) => [

        item.data.primarySource?.type,

        item.data.discovery?.type,

      ]
    )
  );

