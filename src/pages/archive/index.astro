---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";


const items = (
  await getCollection(
    "archive",
    ({ data }) => !data.private
  )
).sort(
  (a, b) =>
    b.data.dateFound.getTime() -
    a.data.dateFound.getTime()
);


/* ---------------------------------
   BUILD FILTER OPTIONS AUTOMATICALLY
--------------------------------- */

const kinds = Array.from(
  new Set(
    items
      .map((item) => item.data.kind)
      .filter(Boolean)
  )
).sort();


const collections = Array.from(
  new Set(
    items.flatMap(
      (item) => item.data.collections
    )
  )
).sort();


const locations = Array.from(
  new Set(
    items
      .map((item) => item.data.location)
      .filter(Boolean)
  )
).sort();
---

<BaseLayout title="archive — ping's archive">

  <section class="page-heading">

    <div>

      <p class="page-label">
        archive
      </p>

      <h1 class="page-title">
        all findings
      </h1>

    </div>


    <p
      class="page-count"
      data-result-count
    >

      {String(items.length).padStart(4, "0")} objects

    </p>

  </section>



  <section
    class="archive-toolbar"
    data-archive-controls
  >


    <!-- SEARCH -->

    <div class="archive-search-row">

      <label for="archive-search">
        search
      </label>


      <input
        id="archive-search"
        type="search"
        placeholder="search the archive..."
        disabled={items.length === 0}
      />

    </div>



    <!-- VIEW + SORT -->

    <div class="archive-toolbar-row">


      <div class="view-control">

        <span class="control-label">
          view
        </span>


        <button
          class="view-button is-active"
          type="button"
          data-view-button="grid"
          aria-pressed="true"
        >
          grid
        </button>


        <button
          class="view-button"
          type="button"
          data-view-button="index"
          aria-pressed="false"
        >
          index
        </button>

      </div>



      <div class="sort-control">

        <label
          class="control-label"
          for="archive-sort"
        >
          sort
        </label>


        <select
          id="archive-sort"
          disabled={items.length === 0}
        >

          <option value="newest">
            newest found
          </option>

          <option value="oldest">
            oldest found
          </option>

          <option value="az">
            a–z
          </option>

          <option value="za">
            z–a
          </option>

        </select>

      </div>


    </div>



    <!-- FILTERS -->

    <details class="archive-filters" open>

      <summary>
        filter archive
      </summary>


      <div class="filter-grid">


        <!-- WHAT IS IT -->

        <div class="filter-field">

          <label for="filter-kind">
            what is it?
          </label>


          <select
            id="filter-kind"
            disabled={items.length === 0}
          >

            <option value="all">
              all
            </option>


            {
              kinds.map((kind) => (

                <option value={kind}>
                  {kind}
                </option>

              ))
            }

          </select>

        </div>



        <!-- COLLECTION -->

        <div class="filter-field">

          <label for="filter-collection">
            collection
          </label>


          <select
            id="filter-collection"
            disabled={items.length === 0}
          >

            <option value="all">
              all collections
            </option>


            {
              collections.map((collection) => (

                <option value={collection}>
                  {collection}
                </option>

              ))
            }

          </select>

        </div>



        <!-- LOCATION -->

        <div class="filter-field">

          <label for="filter-location">
            location
          </label>


          <select
            id="filter-location"
            disabled={items.length === 0}
          >

            <option value="all">
              all locations
            </option>


            {
              locations.map((location) => (

                <option value={location}>
                  {location}
                </option>

              ))
            }

          </select>

        </div>


      </div>

    </details>

  </section>



  <!-- ==================================
       ARCHIVE RESULTS
  =================================== -->

  <section
    class="archive-results"
    data-archive
    data-view="grid"
  >


    {
      items.map((item, index) => (

        <a
          href={`/archive/${item.id}/`}
          class="archive-entry"

          data-title={item.data.title.toLowerCase()}

          data-search={
            [
              item.data.title,
              item.data.creator,
              item.data.archiveDescription,
              item.data.location,
              item.data.kind,
              item.data.reason,
              item.data.sourceName,

              ...item.data.tags,
              ...item.data.colors,
              ...item.data.collections

            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase()
          }

          data-kind={
            (item.data.kind || "")
              .toLowerCase()
          }

          data-collections={
            item.data.collections
              .map((value) =>
                value.toLowerCase()
              )
              .join("|")
          }

          data-location={
            (item.data.location || "")
              .toLowerCase()
          }

          data-date={
            item.data.dateFound.toISOString()
          }
        >


          <!-- IMAGE -->

          <div class="archive-entry-image">

            <img
              src={item.data.image}
              alt={item.data.alt || item.data.title}
              loading="lazy"
            />

          </div>



          <!-- INFORMATION -->

          <div class="archive-entry-information">


            <span class="archive-accession">

              NO. {
                item.data.accession ||
                String(index + 1).padStart(4, "0")
              }

            </span>



            <h2>
              {item.data.title}
            </h2>



            <p class="archive-entry-meta">

              {
                [
                  item.data.kind,
                  item.data.location
                ]
                  .filter(Boolean)
                  .join(" / ")
              }

            </p>



            <time
              datetime={
                item.data.dateFound.toISOString()
              }
            >

              {
                item.data.dateFound.toLocaleDateString(
                  "en-US",
                  {
                    month: "short",
                    day: "numeric",
                    year: "numeric"
                  }
                )
              }

            </time>


          </div>

        </a>

      ))
    }


  </section>



  <!-- EMPTY ARCHIVE -->

  {
    items.length === 0 && (

      <div class="archive-empty-state">

        <span>
          0000
        </span>


        <p>
          the archive is empty.
        </p>


        <small>
          structure first. objects later.
        </small>

      </div>

    )
  }



  <!-- NO SEARCH RESULTS -->

  <div
    class="archive-no-results"
    data-no-results
    hidden
  >

    <p>
      no findings match your search.
    </p>

  </div>



  <!-- ==================================
       INTERACTIVITY
  =================================== -->

  <script>


    const archive =
      document.querySelector<HTMLElement>(
        "[data-archive]"
      );


    const search =
      document.querySelector<HTMLInputElement>(
        "#archive-search"
      );


    const kind =
      document.querySelector<HTMLSelectElement>(
        "#filter-kind"
      );


    const collection =
      document.querySelector<HTMLSelectElement>(
        "#filter-collection"
      );


    const location =
      document.querySelector<HTMLSelectElement>(
        "#filter-location"
      );


    const sort =
      document.querySelector<HTMLSelectElement>(
        "#archive-sort"
      );


    const count =
      document.querySelector<HTMLElement>(
        "[data-result-count]"
      );


    const noResults =
      document.querySelector<HTMLElement>(
        "[data-no-results]"
      );


    const entries =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".archive-entry"
        )
      );



    /* ---------------------------------
       MULTIPLE-VALUE FILTER
    --------------------------------- */

    function containsValue(
      source: string | undefined,
      selected: string
    ) {

      if (selected === "all") {
        return true;
      }


      return (source || "")
        .split("|")
        .includes(selected);

    }



    /* ---------------------------------
       FILTER EVERYTHING
    --------------------------------- */

    function applyFilters() {


      const query =
        search?.value
          .trim()
          .toLowerCase() || "";


      let visible = 0;



      entries.forEach((entry) => {


        const matchesSearch =
          !query ||
          (entry.dataset.search || "")
            .includes(query);


        const matchesKind =
          !kind ||
          kind.value === "all" ||
          entry.dataset.kind ===
            kind.value.toLowerCase();


        const matchesCollection =
          !collection ||
          containsValue(
            entry.dataset.collections,
            collection.value.toLowerCase()
          );


        const matchesLocation =
          !location ||
          location.value === "all" ||
          entry.dataset.location ===
            location.value.toLowerCase();


        const show =
          matchesSearch &&
          matchesKind &&
          matchesCollection &&
          matchesLocation;


        entry.hidden = !show;


        if (show) {
          visible++;
        }

      });



      if (count) {

        count.textContent =
          `${String(visible).padStart(4, "0")} objects`;

      }



      if (noResults) {

        noResults.hidden =
          visible !== 0 ||
          entries.length === 0;

      }

    }



    /* ---------------------------------
       LISTEN TO SEARCH + FILTERS
    --------------------------------- */

    search?.addEventListener(
      "input",
      applyFilters
    );


    kind?.addEventListener(
      "change",
      applyFilters
    );


    collection?.addEventListener(
      "change",
      applyFilters
    );


    location?.addEventListener(
      "change",
      applyFilters
    );



    /* ---------------------------------
       SORT
    --------------------------------- */

    sort?.addEventListener(
      "change",
      () => {


        if (!archive) {
          return;
        }


        const sorted =
          [...entries];



        sorted.sort((a, b) => {


          if (sort.value === "oldest") {

            return (
              new Date(
                a.dataset.date || ""
              ).getTime()
              -
              new Date(
                b.dataset.date || ""
              ).getTime()
            );

          }



          if (sort.value === "az") {

            return (
              a.dataset.title || ""
            ).localeCompare(
              b.dataset.title || ""
            );

          }



          if (sort.value === "za") {

            return (
              b.dataset.title || ""
            ).localeCompare(
              a.dataset.title || ""
            );

          }



          return (
            new Date(
              b.dataset.date || ""
            ).getTime()
            -
            new Date(
              a.dataset.date || ""
            ).getTime()
          );

        });



        sorted.forEach((entry) => {

          archive.appendChild(entry);

        });


      }
    );



    /* ---------------------------------
       GRID / INDEX SWITCHER
    --------------------------------- */

    const viewButtons =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-view-button]"
      );



    viewButtons.forEach((button) => {


      button.addEventListener(
        "click",
        () => {


          if (!archive) {
            return;
          }


          const view =
            button.dataset.viewButton ||
            "grid";


          archive.dataset.view =
            view;



          viewButtons.forEach(
            (otherButton) => {


              const active =
                otherButton === button;


              otherButton.classList.toggle(
                "is-active",
                active
              );


              otherButton.setAttribute(
                "aria-pressed",
                String(active)
              );


            }
          );


        }
      );


    });


  </script>


</BaseLayout>