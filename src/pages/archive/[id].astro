---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveMedia from "../../components/ArchiveMedia.astro";
import { getCollection, render } from "astro:content";


/* ==========================================================
   HELPERS
========================================================== */

function normalized(values = []) {
  return values
    .filter(Boolean)
    .map((value) =>
      String(value)
        .trim()
        .toLowerCase()
    );
}


function overlapCount(a = [], b = []) {
  const left = new Set(normalized(a));
  const right = normalized(b);

  return right.filter((value) =>
    left.has(value)
  ).length;
}


function formatOriginalDate(details) {

  if (!details) {
    return "";
  }

  const monthNames = {
    january: "JAN",
    february: "FEB",
    march: "MAR",
    april: "APR",
    may: "MAY",
    june: "JUN",
    july: "JUL",
    august: "AUG",
    september: "SEP",
    october: "OCT",
    november: "NOV",
    december: "DEC",
  };


  const seasonNames = {
    spring: "SPRING",
    summer: "SUMMER",
    autumn: "AUTUMN",
    winter: "WINTER",
    "spring/summer": "S/S",
    "fall/winter": "F/W",
  };


  let dateCore = "";


  if (details.eraLabel?.trim()) {

    dateCore =
      details.eraLabel.trim();

  } else if (
    details.year &&
    details.endYear
  ) {

    dateCore =
      `${details.year}–${details.endYear}`;

  } else if (details.year) {

    if (
      details.day &&
      details.month
    ) {

      dateCore =
        `${details.day} ${
          monthNames[details.month] ||
          details.month
        } ${details.year}`;

    } else if (details.month) {

      dateCore =
        `${
          monthNames[details.month] ||
          details.month
        } ${details.year}`;

    } else if (details.season) {

      dateCore =
        `${
          seasonNames[details.season] ||
          details.season.toUpperCase()
        } ${details.year}`;

    } else {

      dateCore =
        String(details.year);

    }

  } else if (details.season) {

    dateCore =
      seasonNames[details.season] ||
      details.season.toUpperCase();

  }


  const qualifier =
    details.qualifier;


  if (
    qualifier &&
    qualifier !== "exact" &&
    qualifier !== "range" &&
    qualifier !== "unknown"
  ) {

    const qualifierLabels = {
      circa: "C.",
      before: "BEFORE",
      after: "AFTER",
      early: "EARLY",
      mid: "MID",
      late: "LATE",
    };

    const label =
      qualifierLabels[qualifier];

    if (label) {
      dateCore =
        `${label} ${dateCore}`.trim();
    }

  }


  if (
    qualifier === "unknown" &&
    !dateCore
  ) {
    dateCore = "UNKNOWN";
  }


  if (details.timeOfDay) {

    const time =
      details.timeOfDay.toUpperCase();

    dateCore =
      dateCore
        ? `${dateCore} · ${time}`
        : time;

  }


  return dateCore;
}



/* ==========================================================
   STATIC PATHS
========================================================== */

export async function getStaticPaths() {
  
  function normalized(values = []) {
    return values
      .filter(Boolean)
      .map((value) =>
        String(value)
          .trim()
          .toLowerCase()
      );
  }

  function overlapCount(a = [], b = []) {
    const left = new Set(normalized(a));
    const right = normalized(b);

    return right.filter((value) =>
      left.has(value)
    ).length;
  }
  const items = (
    await getCollection(
      "archive",
      ({ data }) => !data.private
    )
  ).sort(
    (a, b) =>
      b.data.dateFound.getTime() -
      a.data.dateFound.getTime()
  );


  return items.map((item, index) => {

    const previous =
      index < items.length - 1
        ? items[index + 1]
        : null;


    const next =
      index > 0
        ? items[index - 1]
        : null;


    /* ------------------------------------------------------
       RELATED FINDINGS

       New metadata is weighted first.

       Old metadata remains usable while older findings
       wait to be re-edited.
    ------------------------------------------------------ */

    const related =
      items

        .filter(
          (candidate) =>
            candidate.id !== item.id
        )

        .map((candidate) => {

          let score = 0;


          /* CREATORS */

          const itemCreators =
            item.data.creators?.map(
              (creator) => creator.name
            ) || [];

          const candidateCreators =
            candidate.data.creators?.map(
              (creator) => creator.name
            ) || [];

          score +=
            overlapCount(
              itemCreators,
              candidateCreators
            ) * 4;


          /* PRIMARY OBJECT TYPE */

          if (
            item.data.primaryObjectType &&
            candidate.data.primaryObjectType ===
              item.data.primaryObjectType
          ) {
            score += 3;
          }


          /* THEMES */

          score +=
            overlapCount(
              item.data.themes,
              candidate.data.themes
            ) * 2;


          /* MEDIUM */

          score +=
            overlapCount(
              item.data.mediums,
              candidate.data.mediums
            );


          /* COLORS */

          score +=
            overlapCount(
              item.data.colors,
              candidate.data.colors
            );


          /* LOCATION */

          score +=
            overlapCount(
              item.data.locations,
              candidate.data.locations
            );


          /* ----------------------------------------------
             TEMPORARY OLD-METADATA RELATEDNESS
          ---------------------------------------------- */

          if (
            item.data.kind &&
            candidate.data.kind ===
              item.data.kind
          ) {
            score += 2;
          }


          score +=
            overlapCount(
              item.data.tags,
              candidate.data.tags
            );


          score +=
            overlapCount(
              item.data.collections,
              candidate.data.collections
            ) * 2;


          return {
            item: candidate,
            score,
          };

        })

        .filter(
          ({ score }) =>
            score > 0
        )

        .sort(
          (a, b) =>
            b.score - a.score
        )

        .slice(0, 4)

        .map(
          ({ item }) =>
            item
        );


    return {

      params: {
        id: item.id,
      },

      props: {
        item,
        previous,
        next,
        related,
      },

    };

  });

}



/* ==========================================================
   CURRENT FINDING
========================================================== */

const {
  item,
  previous,
  next,
  related,
} = Astro.props;


const { Content } =
  await render(item);


const hasNotes =
  Boolean(
    item.body?.trim()
  );


const findingNumber =
  item.data.archiveNumber ||
  "----";



/* ==========================================================
   DATE
========================================================== */

const newOriginalDate =
  formatOriginalDate(
    item.data.originalDateDetails
  );


const originalDateDisplay =
  newOriginalDate ||
  item.data.originalDate ||
  "";


const dateNote =
  item.data.originalDateDetails
    ?.dateNote;



/* ==========================================================
   CREATORS
========================================================== */

const creators =
  item.data.creators?.length
    ? item.data.creators
    : item.data.creator
      ? [
          {
            name: item.data.creator,
            role: undefined,
          },
        ]
      : [];



/* ==========================================================
   LOCATION
========================================================== */

const legacyPlace =
  item.data.location ||

  [
    item.data.venue,
    item.data.neighborhood,
    item.data.city,
    item.data.region,
    item.data.country,
  ]

    .filter(Boolean)
    .join(", ");


const locations =
  item.data.locations?.length
    ? item.data.locations
    : legacyPlace
      ? [legacyPlace]
      : [];



/* ==========================================================
   OBJECT TYPE
========================================================== */

const primaryObjectType =
  item.data.primaryObjectType ||
  item.data.kind ||
  "";



/* ==========================================================
   ADDITIONAL MEDIA

   New Additional Media is used when present.

   Existing Gallery + Attachments stay visible until that
   finding is re-edited into the new system.
========================================================== */

const additionalMedia =
  item.data.additionalMedia?.length
    ? item.data.additionalMedia
    : [

        ...(item.data.gallery || []).map(
          (photo) => ({
            mediaType: "image",
            file: photo.image,
            caption: photo.caption,
            credit: photo.credit,
            sourceUrl: photo.sourceUrl,
          })
        ),

        ...(item.data.attachments || []).map(
          (attachment) => ({
            mediaType: "document",
            file: attachment.file,
            caption: attachment.title,
            credit: undefined,
            sourceUrl: undefined,
          })
        ),

      ];



/* ==========================================================
   SOURCE
========================================================== */

const primarySource =
  item.data.primarySource &&
  (
    item.data.primarySource.name ||
    item.data.primarySource.url ||
    item.data.primarySource.type
  )
    ? item.data.primarySource
    : (
        item.data.sourceName ||
        item.data.sourceUrl
      )
      ? {
          type: undefined,
          name: item.data.sourceName,
          url: item.data.sourceUrl,
        }
      : null;



/* ==========================================================
   DISCOVERY
========================================================== */

const discovery =
  item.data.discovery &&
  (
    item.data.discovery.name ||
    item.data.discovery.url ||
    item.data.discovery.type
  )
    ? item.data.discovery
    : null;



/* ==========================================================
   FOUND DATE

   UTC prevents a date-only value from appearing as the
   previous day because of timezone conversion.
========================================================== */

const dateFoundDisplay =
  item.data.dateFound.toLocaleDateString(
    "en-US",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }
  );
---

<BaseLayout
  title={`${item.data.title} — ping's archive`}
>

  <article class="object-file">


    <!-- ====================================================
         TOP LINE
    ===================================================== -->

    <div class="object-topline">

      <a
        href="/archive"
        class="object-back"
      >
        ← archive
      </a>

      <span>
        finding no. {findingNumber}
      </span>

    </div>



    <!-- ====================================================
         COVER + TITLE
    ===================================================== -->

    <section class="object-hero">

      <div class="object-image-wrap">

        <ArchiveMedia
          src={item.data.image}
          coverType={item.data.coverType}
          poster={item.data.videoPoster}
          alt={
            item.data.alt ||
            item.data.title
          }
          title={item.data.title}
          context="detail"
          loading="eager"
        />

      </div>


      <div class="object-introduction">

        <p class="object-accession">
          finding no. {findingNumber}
        </p>

        <h1 class="object-title">
          {item.data.title}
        </h1>

        {
          item.data.archiveDescription && (

            <p class="object-summary">
              {item.data.archiveDescription}
            </p>

          )
        }

      </div>

    </section>



    <!-- ====================================================
         METADATA
    ===================================================== -->

    <section class="object-metadata">


      {
        creators.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              creator
            </span>

            <span class="metadata-value metadata-stack">

              {
                creators.map(
                  (creator) => (

                    <span>

                      {creator.name}

                      {
                        creator.role && (
                          <small>
                            {" / "}
                            {creator.role}
                          </small>
                        )
                      }

                    </span>

                  )
                )
              }

            </span>

          </div>

        )
      }


      {
        originalDateDisplay && (

          <div class="metadata-row">

            <span class="metadata-label">
              original date
            </span>

            <span class="metadata-value">
              {originalDateDisplay}
            </span>

          </div>

        )
      }


      {
        dateNote && (

          <div class="metadata-row">

            <span class="metadata-label">
              date note
            </span>

            <span class="metadata-value">
              {dateNote}
            </span>

          </div>

        )
      }


      <div class="metadata-row">

        <span class="metadata-label">
          found
        </span>

        <span class="metadata-value">
          {dateFoundDisplay}
        </span>

      </div>


      {
        primaryObjectType && (

          <div class="metadata-row">

            <span class="metadata-label">
              object type
            </span>

            <span class="metadata-value">
              {primaryObjectType}
            </span>

          </div>

        )
      }


      {
        item.data.secondaryObjectTypes
          ?.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              secondary
            </span>

            <span class="metadata-value">
              {
                item.data
                  .secondaryObjectTypes
                  .join(" / ")
              }
            </span>

          </div>

        )
      }


      {
        item.data.mediums
          ?.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              medium / material
            </span>

            <span class="metadata-value">
              {
                item.data.mediums
                  .join(" / ")
              }
            </span>

          </div>

        )
      }


      {
        item.data.themes
          ?.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              themes / concepts
            </span>

            <span class="metadata-value">
              {
                item.data.themes
                  .join(" / ")
              }
            </span>

          </div>

        )
      }


      {
        locations.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              location
            </span>

            <span class="metadata-value">
              {locations.join(" / ")}
            </span>

          </div>

        )
      }


      {
        item.data.colors
          ?.length > 0 && (

          <div class="metadata-row">

            <span class="metadata-label">
              color
            </span>

            <span class="metadata-value">
              {
                item.data.colors
                  .join(" / ")
              }
            </span>

          </div>

        )
      }


      {
        item.data.colorNotes && (

          <div class="metadata-row">

            <span class="metadata-label">
              color notes
            </span>

            <span class="metadata-value">
              {item.data.colorNotes}
            </span>

          </div>

        )
      }


      {
        item.data.seriesProject && (

          <div class="metadata-row">

            <span class="metadata-label">
              series / project
            </span>

            <span class="metadata-value">
              {item.data.seriesProject}
            </span>

          </div>

        )
      }


      {
        item.data.bodyOfWork && (

          <div class="metadata-row">

            <span class="metadata-label">
              body of work
            </span>

            <span class="metadata-value">
              {item.data.bodyOfWork}
            </span>

          </div>

        )
      }


      {
        item.data.reason && (

          <div class="metadata-row">

            <span class="metadata-label">
              why i saved it
            </span>

            <span class="metadata-value">
              {item.data.reason}
            </span>

          </div>

        )
      }

    </section>



    <!-- ====================================================
         ADDITIONAL MEDIA
    ===================================================== -->

    {
      additionalMedia.length > 0 && (

        <section class="object-gallery">

          <div class="object-section-heading">

            <span>
              additional media
            </span>

            <span>
              {
                String(
                  additionalMedia.length
                ).padStart(2, "0")
              }
            </span>

          </div>


          <div class="object-additional-media">

            {
              additionalMedia.map(
                (media, index) => (

                  <figure class="additional-media-item">

                    {
                      media.mediaType ===
                      "document" ? (

                        <a
                          href={media.file}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="additional-document"
                        >

                          <span>
                            FILE {
                              String(
                                index + 1
                              ).padStart(2, "0")
                            }
                          </span>

                          <strong>
                            {
                              media.caption ||
                              "document"
                            }
                          </strong>

                          <span>
                            ↗
                          </span>

                        </a>

                      ) : (

                        <div class="additional-media-object">

                          <ArchiveMedia
                            src={media.file}
                            coverType={
                              media.mediaType ===
                              "image"
                                ? "image"
                                : media.mediaType
                            }
                            alt={
                              media.caption ||
                              item.data.title
                            }
                            title={
                              media.caption ||
                              item.data.title
                            }
                            context="detail"
                            loading="lazy"
                          />

                        </div>

                      )
                    }


                    {
                      (
                        media.mediaType !==
                          "document" &&
                        (
                          media.caption ||
                          media.credit ||
                          media.sourceUrl
                        )
                      ) && (

                        <figcaption>

                          <span class="gallery-number">
                            MEDIA {
                              String(
                                index + 1
                              ).padStart(2, "0")
                            }
                          </span>


                          {
                            media.caption && (

                              <span class="gallery-caption">
                                {media.caption}
                              </span>

                            )
                          }


                          {
                            media.credit && (

                              <span class="gallery-credit">
                                {media.credit}
                              </span>

                            )
                          }


                          {
                            media.sourceUrl && (

                              <a
                                href={media.sourceUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="gallery-source"
                              >
                                source ↗
                              </a>

                            )
                          }

                        </figcaption>

                      )
                    }

                  </figure>

                )
              )
            }

          </div>

        </section>

      )
    }



    <!-- ====================================================
         NOTES
    ===================================================== -->

    {
      hasNotes && (

        <section class="object-notes">

          <div class="object-section-label">
            notes
          </div>

          <div class="object-body">
            <Content />
          </div>

        </section>

      )
    }



    <!-- ====================================================
         PRIMARY SOURCE
    ===================================================== -->

    {
      primarySource && (

        <section class="object-source">

          <span class="metadata-label">
            primary source
          </span>

          {
            primarySource.url ? (

              <a
                href={primarySource.url}
                target="_blank"
                rel="noopener noreferrer"
              >

                {
                  primarySource.name ||
                  primarySource.type ||
                  "source"
                }

                {" ↗"}

              </a>

            ) : (

              <span>

                {
                  primarySource.name ||
                  primarySource.type
                }

              </span>

            )
          }

        </section>

      )
    }



    <!-- ====================================================
         DISCOVERED VIA
    ===================================================== -->

    {
      discovery && (

        <section class="object-source">

          <span class="metadata-label">
            discovered via
          </span>

          {
            discovery.url ? (

              <a
                href={discovery.url}
                target="_blank"
                rel="noopener noreferrer"
              >

                {
                  discovery.name ||
                  discovery.type ||
                  "discovery source"
                }

                {" ↗"}

              </a>

            ) : (

              <span>

                {
                  discovery.name ||
                  discovery.type
                }

              </span>

            )
          }

        </section>

      )
    }



    <!-- ====================================================
         RELATED FINDINGS
    ===================================================== -->

    {
      related.length > 0 && (

        <section class="related-section">

          <div class="object-section-heading">

            <span>
              related findings
            </span>

            <span>
              {
                String(
                  related.length
                ).padStart(2, "0")
              }
            </span>

          </div>


          <div class="related-grid">

            {
              related.map(
                (relatedItem) => (

                  <a
                    href={
                      `/archive/${relatedItem.id}/`
                    }
                    class="related-item"
                  >

                    <div class="related-image">

                      <ArchiveMedia
                        src={
                          relatedItem.data.image
                        }
                        coverType={
                          relatedItem.data
                            .coverType
                        }
                        poster={
                          relatedItem.data
                            .videoPoster
                        }
                        alt={
                          relatedItem.data.alt ||
                          relatedItem.data.title
                        }
                        title={
                          relatedItem.data.title
                        }
                        context="card"
                        loading="lazy"
                      />

                    </div>

                    <span>
                      {relatedItem.data.title}
                    </span>

                  </a>

                )
              )
            }

          </div>

        </section>

      )
    }



    <!-- ====================================================
         PREVIOUS / NEXT
    ===================================================== -->

    <nav class="object-pagination">

      <div>

        {
          previous ? (

            <a
              href={
                `/archive/${previous.id}/`
              }
            >

              <span class="pagination-label">
                previous
              </span>

              <span>
                ← {previous.data.title}
              </span>

            </a>

          ) : (

            <span class="pagination-empty">
              previous / —
            </span>

          )
        }

      </div>


      <div class="pagination-next">

        {
          next ? (

            <a
              href={
                `/archive/${next.id}/`
              }
            >

              <span class="pagination-label">
                next
              </span>

              <span>
                {next.data.title} →
              </span>

            </a>

          ) : (

            <span class="pagination-empty">
              next / —
            </span>

          )
        }

      </div>

    </nav>

  </article>

</BaseLayout>


<style>

  /* Only the pieces introduced by the new metadata system.
     Existing object-page styling remains in global.css. */


  .metadata-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }


  .metadata-stack > span {
    display: block;
  }


  .metadata-stack small {
    font: inherit;
    font-size: 8px;
    font-weight: 400;
    opacity: 0.62;
  }


  .object-additional-media {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      70px 22px;

    padding-top: 26px;
  }


  .additional-media-item {
    min-width: 0;
    margin: 0;
  }


  .additional-media-object {
    width: 100%;
  }


  .additional-media-item figcaption {
    display: grid;

    grid-template-columns:
      75px
      minmax(0, 1fr)
      auto;

    gap: 10px;

    margin-top: 8px;
    padding-top: 5px;

    border-top:
      1px solid var(--blue-faint);

    font-size: 7px;
    line-height: 1.4;

    text-transform: uppercase;
  }


  .additional-document {
    display: grid;

    grid-template-columns:
      75px
      minmax(0, 1fr)
      20px;

    gap: 12px;

    align-items: baseline;

    padding:
      12px 0;

    border-top:
      1px solid var(--blue);

    border-bottom:
      1px solid var(--blue);

    text-transform: uppercase;
  }


  .additional-document > span:first-child {
    font-size: 7px;
  }


  .additional-document strong {
    font-size: 10px;
    font-weight: 500;
  }


  .additional-document > span:last-child {
    text-align: right;
  }


  .additional-document:hover strong {
    text-decoration: underline;
  }


  @media (max-width: 750px) {

    .object-additional-media {
      grid-template-columns: 1fr;
      gap: 50px;
    }


    .additional-media-item figcaption {
      grid-template-columns:
        65px
        1fr;
    }


    .gallery-credit,
    .gallery-source {
      grid-column: 2;
      text-align: left;
    }

  }

</style>