---
interface Props {
  src: string;
  coverType?: "image" | "loop" | "video";
  poster?: string;
  alt?: string;
  title?: string;
  context?: "card" | "detail";
  loading?: "eager" | "lazy";
}

const {
  src,
  coverType = "image",
  poster,
  alt = "",
  title = "Archive media",
  context = "card",
  loading = "lazy",
} = Astro.props;

const extension = src
  .split("?")[0]
  .split("#")[0]
  .split(".")
  .pop()
  ?.toLowerCase();

const isVideoFile = ["mp4", "webm", "mov"].includes(
  extension || ""
);

const renderAsLoop =
  coverType === "loop" && isVideoFile;

const renderAsVideo =
  coverType === "video" && isVideoFile;
---

<div
  class:list={[
    "archive-media",
    `archive-media-${coverType}`,
    `archive-media-${context}`,
  ]}
  data-cover-type={coverType}
>
  {
    renderAsLoop ? (
      <video
        class="archive-media-element archive-media-loop"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={poster}
        aria-label={title}
      >
        <source src={src} />
      </video>
    ) : renderAsVideo ? (
      context === "detail" ? (
        <video
          class="archive-media-element archive-media-video"
          controls
          playsinline
          preload="metadata"
          poster={poster}
          aria-label={title}
        >
          <source src={src} />
        </video>
      ) : (
        <video
          class="archive-media-element archive-media-video-preview"
          muted
          playsinline
          preload="metadata"
          poster={poster}
          aria-label={`${title} — video`}
        >
          <source src={src} />
        </video>
      )
    ) : (
      <img
        class="archive-media-element archive-media-image"
        src={src}
        alt={alt}
        loading={loading}
      />
    )
  }
</div>

<script>
  function initializeArchiveLoops() {
    const loops = document.querySelectorAll(
      '[data-cover-type="loop"]'
    );

    loops.forEach((wrapper) => {
      const video = wrapper.querySelector("video");

      if (video) {
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;

        const tryToPlay = () => {
          if (video.paused) {
            video.play().catch(() => {
              // Some mobile browsers may require one tap.
            });
          }
        };

        tryToPlay();

        video.addEventListener(
          "loadedmetadata",
          tryToPlay
        );

        video.addEventListener(
          "canplay",
          tryToPlay
        );
      }

      if (wrapper.dataset.loopInteractionReady === "true") {
        return;
      }

      wrapper.dataset.loopInteractionReady = "true";

      wrapper.addEventListener("click", (event) => {
        /*
          A GIF / Loop is meant to be viewable in the feed.
          Do not let a tap on the moving media activate
          a surrounding archive-card link.
        */
        event.preventDefault();
        event.stopPropagation();

        if (video && video.paused) {
          video.play().catch(() => {});
        }
      });
    });
  }

  initializeArchiveLoops();

  document.addEventListener(
    "astro:page-load",
    initializeArchiveLoops
  );

  window.addEventListener("pageshow", () => {
    initializeArchiveLoops();
  });

  document.addEventListener(
    "visibilitychange",
    () => {
      if (!document.hidden) {
        initializeArchiveLoops();
      }
    }
  );
</script>

<style>
  .archive-media {
    display: block;
    width: 100%;
  }

  .archive-media-element {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  .archive-media-loop,
  .archive-media-video,
  .archive-media-video-preview {
    object-fit: contain;
  }

  .archive-media-loop {
    cursor: default;
  }
</style>