---
import "../styles/global.css";
import { getCollection } from "astro:content";

const {
  title = "ping's archive",
  description = "a personal archive of creative findings"
} = Astro.props;


const archiveItems =
  await getCollection(
    "archive",
    ({ data }) => !data.private
  );


const totalFindings =
  archiveItems.length;


const pathname =
  Astro.url.pathname;


function isActive(path) {

  if (path === "/") {
    return pathname === "/";
  }

  return pathname.startsWith(path);

}
---

<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

  </head>


  <body>


    <header class="site-header">


      <!-- TOP TECHNICAL LINE -->

      <div class="document-code">

        <span>
          QUEENS, NYC
        </span>

        <span class="header-archive-count">
          {String(totalFindings).padStart(4, "0")}
        </span>

        <span>
          EST. 2026
        </span>

      </div>



      <!-- MAIN HEADER -->

      <div class="masthead">


        <div class="masthead-copy">

          <a
            class="site-title"
            href="/"
          >
            ping's archive
          </a>

          <p class="site-description"></p>

        </div>



       <div class="archive-plate">

  <div class="archive-plate-top">
    YEAR OF THE TIGER
  </div>

  <div class="archive-plate-main">
    MADISON ZY PING CHAN MCNALLY
  </div>

  <div class="archive-plate-bottom">

    <span>
      ARCHIVE STATUS
    </span>

    <span>
      ACTIVE
    </span>

  </div>

</div>

        </div>

      <!-- NAVIGATION -->

      <nav class="site-nav">

        <a
          href="/"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/") }
          ]}
        >
          index
        </a>


        <a
          href="/archive"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/archive") }
          ]}
        >
          archive
        </a>


        <a
          href="/collections"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/collections") }
          ]}
        >
          collections
        </a>


        <a
          href="/notes"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/notes") }
          ]}
        >
          notes
        </a>


        <a
          href="/about"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/about") }
          ]}
        >
          about
        </a>


        <a
          href="/random"
          class:list={[
            "nav-stamp-link",
            { "is-current": isActive("/random") }
          ]}
        >
          random ↗
        </a>

      </nav>


    </header>



    <main class="site-main">

      <slot />

    </main>



    <footer class="site-footer">

      <span>
        ping's archive
      </span>

      <span>
        new york
      </span>

      <span>
        continually updated
      </span>

    </footer>


  </body>

</html>